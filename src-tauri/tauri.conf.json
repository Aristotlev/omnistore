{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniStore",
  "version": "../package.json",
  "identifier": "app.omnistore",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OmniStore",
        "width": 1320,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Aristotle",
    "shortDescription": "Every cloud plan, device and drive in one dashboard",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyMzRGRDdBODA4REU1MjcKUldRbjVZMkFldjAwY3VyL2FITUF6ZitVeDdLMTY3MS8zSDdMaHY2Yk9HYk5BLzhQeDdQU0lla1UK",
      "endpoints": [
        "https://github.com/Aristotlev/omnistore/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
